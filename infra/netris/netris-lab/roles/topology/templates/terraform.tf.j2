terraform {
  required_providers {
    netris = {
      source  = "netrisai/netris"
      # Netris controller versions deployed by this backend require the tenant
      # in allocation requests. Provider 3.6.23 removed it, so stay on 3.6.22
      # until the controller and provider API are aligned.
      version = ">= 3.6.3, < 3.6.23"
    }
  }
}

provider "netris" {
  address  = var.controller_url
  login    = "{{ netris_login }}"
  password = "{{ netris_password }}"
}

variable "controller_url" {
  type = string
}

variable "site-name" {
  type = string
}

variable "site" {
  type = object({
    publicasn           = number
    rohroutingprofile   = string
    sitemesh            = string
    acldefaultpolicy    = string
    vlanrangeautoassign = string
  })
  default = {
    publicasn           = 655001
    acldefaultpolicy    = "{{ acl_default_policy | default('deny') }}"
    rohroutingprofile   = "default_agg"
    sitemesh            = "disabled"
    vlanrangeautoassign = "2-3999"
  }
}

data "netris_tenant" "admin" {
  name = "Admin"
}

resource "netris_site" "site1" {
  name                = var.site-name
  publicasn           = var.site.publicasn
  rohasn              = 65500
  vmasn               = 65501
  rohroutingprofile   = var.site.rohroutingprofile
  sitemesh            = var.site.sitemesh
  acldefaultpolicy    = var.site.acldefaultpolicy
  vlanrangeautoassign = var.site.vlanrangeautoassign
}
